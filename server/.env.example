# The ONLY required setting: your MongoDB connection string (MongoDB Atlas, or any MongoDB 6+).
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/ff_stock

# Everything below is optional.
# Secrets (session signing, encryption of stored credentials) and the Business Central / vendor settings
# are created and kept inside the database. Set these only to override them:
# JWT_SECRET=            # openssl rand -base64 48
# APP_ENCRYPTION_KEY=    # openssl rand -base64 32  (keeping it outside the DB means a leaked DB alone can't decrypt credentials)

# The first admin is created from the setup screen shown on first visit.
# Or create it automatically on first start:
# ADMIN_NAME=Administrator
# ADMIN_EMAIL=
# ADMIN_PASSWORD=

# NODE_ENV=production   PORT=4000   TRUST_PROXY=1 (default in production)   COOKIE_SECURE=true (default in production)
# CLIENT_ORIGIN=https://stock.fandf.in   # extra browser origins allowed to make changes
