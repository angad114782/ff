NODE_ENV=production
PORT=4000
# Behind a reverse proxy (nginx, Caddy, a load balancer): number of proxy hops, so rate limiting sees real client IPs.
TRUST_PROXY=1

# Required in production. Generate with: openssl rand -base64 48 / openssl rand -base64 32
JWT_SECRET=
APP_ENCRYPTION_KEY=

# First admin, created on first start only (change the password in Profile afterwards).
ADMIN_NAME=Administrator
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional: where the SQLite DB and uploaded media live. Back this directory up.
# DATA_DIR=/var/lib/ff-stock

# Optional extra browser origins allowed to POST/PUT/PATCH/DELETE (same-origin always works).
# CLIENT_ORIGIN=https://stock.fandf.in

# Optional Business Central defaults. Normally set from Admin -> API Config (stored encrypted).
# BC_TENANT_ID=
# BC_ENVIRONMENT=PRODUCTION
# BC_COMPANY=F&F India Pvt. Limited.
# BC_CLIENT_ID=
# BC_CLIENT_SECRET=
